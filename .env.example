DATABASE_URL=postgresql://growup_app:growup_app_dev@localhost:5433/growupstore
# Privilegiado solo para login global, vitrina pública, admin y cron (ver scripts/setup-app-role.js):
SYSTEM_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/growupstore
REDIS_URL=redis://localhost:6380
JWT_SECRET=cambia-esto-32-chars-minimo
JWT_REFRESH_SECRET=cambia-esto-otro-32-chars-minimo
JWT_EXPIRES_IN=7d
AES_SERVICE_KEY=cambia-esto-32-bytes-base64!!!
BOLD_WEBHOOK_SECRET=whsec_demo
MOCK_PAYMENTS=true
META_APP_ID=demo
NEXT_PUBLIC_API_URL=http://localhost:3002/api/v1
NEXT_PUBLIC_TENANT_ID=demo-tenant
# --- Edge / subdominios (PASO 1: fix NXDOMAIN) ---
# Dominio base de tiendas: https://<slug>.STORE_DOMAIN
STORE_DOMAIN=growupstore.app
# Secreto compartido edge↔API para GET /api/v1/internal/caddy-ask (On-Demand TLS)
INTERNAL_EDGE_SECRET=cambia-este-secreto-edge
# --- Dominios: proveedor configurable (Namecheap). Sin estas 3, el buscador usa cotizador local ---
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_CLIENT_IP=
# --- Hosting $0 multi-tienda (ver DEPLOY-FREE.md) ---
# Dominio principal en Vercel/Cloudflare (consola + landing). En local: localhost.
SITE_DOMAIN=growupstore.app
NEXT_PUBLIC_SITE_DOMAIN=growupstore.app
# URL absoluta del principal para redirects desde hosts de tienda.
NEXT_PUBLIC_SITE_URL=https://growupstore.app
# Upstash Redis REST (edge: mapa slug/dominio -> tenant). Sin esto, el middleware
# resuelve directo contra el API (más lento pero funcional).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Supabase (Postgres central; pooler para la app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=
# En producción DATABASE_URL/SYSTEM_DATABASE_URL apuntan al pooler de Supabase.
